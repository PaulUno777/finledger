# FinLedger environment template (ADR-015 / ADR-016)
# Copy:  cp finledger.env.example .env
# Then:  docker compose --profile sandbox up -d --build
#
# Secrets: leave empty or set via your secret store — never commit real values.
# Layers: image defaults → optional ./config/application.yml → these env vars.
#
# Day-0 bootstrap (who creates the first tenant?):
#   sandbox          → seeded tenant + wallets; mint JWT from dump (no IdP)
#   normal+external  → create admin in YOUR IdP (ledger:admin) → POST /api/v1/tenants
#   normal+internal  → client-bound tenant UUID must ALREADY exist (CI/seed);
#                      cold-start without IdP = FL-158 (platform:admin bootstrap)

# --- Spring / runtime ---------------------------------------------------------
# SPRING_PROFILES_ACTIVE=sandbox          # sandbox | normal only (never with FINLEDGER_ENV=production)
# SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081
# JAVA_OPTS=
# MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1

# --- Datasource (Compose app / env overrides) ---------------------------------
# DB_URL=jdbc:postgresql://localhost:5432/finledger
# DB_USERNAME=finledger_app
# DB_PASSWORD=finledger
# SPRING_FLYWAY_USER=finledger
# SPRING_FLYWAY_PASSWORD=finledger

# --- Security (ADR-016) -------------------------------------------------------
FINLEDGER_ENV=local
# external (default for normal / prod) | internal (sandbox always; IdP-less CI)
# FINLEDGER_SECURITY_ISSUER=internal
# FINLEDGER_SECURITY_MAX_TOKEN_TTL=15m
# Prod-like normal: point at your IdP (required for real onboarding without FL-158)
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://your-idp/realms/finledger
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=

# --- Normal + internal issuer (FL-156; durable secrets — never auto-generated) -
# For CI against a PRE-SEEDED tenant UUID (CreateTenant assigns random ids — do not
# expect POST /tenants to match this UUID). Generate PKCS#8 PEM:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -out config/internal-signing.pem
# FINLEDGER_INTERNAL_ISSUER_URI=http://localhost:8080/internal
# FINLEDGER_INTERNAL_SIGNING_KEY_PATH=./config/internal-signing.pem
# Or inline (escape newlines as \n): FINLEDGER_INTERNAL_SIGNING_KEY_PEM=
# FINLEDGER_INTERNAL_PUBLIC_KEY_PEM=
# Tenant-bound machine clients (least privilege — one client → one tenant_id):
# FINLEDGER_SECURITY_INTERNAL_CLIENTS_0_CLIENT_ID=ci
# FINLEDGER_SECURITY_INTERNAL_CLIENTS_0_CLIENT_SECRET=
# FINLEDGER_SECURITY_INTERNAL_CLIENTS_0_TENANT_ID=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
# FINLEDGER_SECURITY_INTERNAL_CLIENTS_0_SCOPES=ledger:read ledger:write ledger:admin

# --- Sandbox mint / dump ------------------------------------------------------
# OpenAPI UI (sandbox/dev): http://localhost:8080/swagger-ui.html  (permitAll)
# Authorize with Bearer from mint; use seeded tenant/accounts from the dump.
# FINLEDGER_SANDBOX_DUMP_PATH=config/sandbox-ready.txt
# FINLEDGER_SANDBOX_BASE_URL=http://localhost:8080
# FINLEDGER_SANDBOX_CLIENT_ID=sandbox
# FINLEDGER_SANDBOX_CLIENT_SECRET=   # blank → generated at boot (see dump)
# Seeded demo IDs (stable): tenant …0001, accounts …0010 / …0011

# --- Optional adapters / features ---------------------------------------------
# FINLEDGER_FRAUD_ENABLED=false
# FINLEDGER_RAIL_WEBHOOK_HMAC_SECRET=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Prod: SPRINGDOC_API_DOCS_ENABLED=false  SPRINGDOC_SWAGGER_UI_ENABLED=false

# --- CLI only (not read by the server) ----------------------------------------
# FINLEDGER_BASE_URL=http://localhost:8080
# FINLEDGER_TOKEN=                         # normal+external: from your IdP/BFF
# FINLEDGER_MANAGEMENT_URL=http://localhost:8081
