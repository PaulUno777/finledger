# FinLedger environment template (ADR-015 / ADR-016)
# Copy:  cp finledger.env.example .env
# Then:  docker compose --profile sandbox up -d --build
#
# Secrets: leave empty or set via your secret store — never commit real values.
# Layers: image defaults → optional ./config/application.yml → these env vars.

# --- Spring / runtime ---------------------------------------------------------
# SPRING_PROFILES_ACTIVE=sandbox          # sandbox | normal only (never mix with production env)
# SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081
# JAVA_OPTS=
# MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1

# --- Datasource (Compose app / env overrides) ---------------------------------
# DB_URL=jdbc:postgresql://localhost:5432/finledger
# DB_USERNAME=finledger_app
# DB_PASSWORD=finledger
# SPRING_FLYWAY_USER=finledger
# SPRING_FLYWAY_PASSWORD=finledger

# --- Redis --------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- Security (ADR-016) -------------------------------------------------------
FINLEDGER_ENV=local
# external (default for normal) | internal (sandbox / IdP-less)
# FINLEDGER_SECURITY_ISSUER=internal
# FINLEDGER_SECURITY_MAX_TOKEN_TTL=15m
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=

# --- Sandbox mint / dump ------------------------------------------------------
# FINLEDGER_SANDBOX_DUMP_PATH=config/sandbox-ready.txt
# FINLEDGER_SANDBOX_BASE_URL=http://localhost:8080
# FINLEDGER_SANDBOX_CLIENT_ID=sandbox
# FINLEDGER_SANDBOX_CLIENT_SECRET=   # blank → generated at boot (see dump)

# --- Optional adapters / features ---------------------------------------------
# FINLEDGER_FRAUD_ENABLED=false
# FINLEDGER_RAIL_WEBHOOK_HMAC_SECRET=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- CLI only (not read by the server) ----------------------------------------
# FINLEDGER_BASE_URL=http://localhost:8080
# FINLEDGER_TOKEN=
# FINLEDGER_MANAGEMENT_URL=http://localhost:8081
